# PostgreSQL connection string (required by every command).
SLOTBOOK_DATABASE_URL=postgres://postgres:postgres@localhost:5432/slotbook_dev?sslmode=disable

# Listen address for "slotbook serve".
SLOTBOOK_ADDR=:8080

# Bearer token for /v1/admin/*. At least 32 characters unless SLOTBOOK_DEV=true.
SLOTBOOK_ADMIN_TOKEN=replace-with-a-long-random-string-0123456789
SLOTBOOK_DEV=false

# Origins allowed to call the API from a browser, comma-separated ("*" for any).
SLOTBOOK_CORS_ORIGINS=http://localhost:5173

# Optional: deliver notifications through a Telegram bot to customers who
# give a chat id. Without a token every notification goes to the log.
SLOTBOOK_TELEGRAM_BOT_TOKEN=
SLOTBOOK_TELEGRAM_API_URL=https://api.telegram.org

# Optional: directory with the built web widget, served at /.
SLOTBOOK_STATIC_DIR=

SLOTBOOK_LOG_LEVEL=info
SLOTBOOK_WORKER_INTERVAL=5s
SLOTBOOK_SWEEP_INTERVAL=30s

# Holds per client address: SLOTBOOK_HOLD_BURST at once, then
# SLOTBOOK_HOLD_RATE (a count per s, min, h or a duration such as 10m).
# 0 turns the limit off.
SLOTBOOK_HOLD_RATE=2/min
SLOTBOOK_HOLD_BURST=10

# Reverse proxies (CIDRs or addresses, comma-separated) whose X-Forwarded-For
# names the client. Leave empty when clients connect directly.
SLOTBOOK_TRUSTED_PROXIES=

# Integration tests only: each test creates and drops its own schema here.
SLOTBOOK_TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/slotbook_test?sslmode=disable
