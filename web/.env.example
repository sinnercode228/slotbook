# Copy to .env.local for local development. Shell variables work as well.
# Only VITE_* values end up in the browser bundle.

# "mock" runs the whole API in the browser on seed/demo.json. Empty: use the server.
VITE_API_MODE=

# Base URL of the API. Empty means the origin that serves the page, which is
# how the Go server hosts the widget (SLOTBOOK_STATIC_DIR).
VITE_API_URL=

# The business name in the header.
VITE_BRAND_NAME=Snipwell & Co.

# Where "npm run dev" and "npm run preview" proxy /v1.
SLOTBOOK_API_TARGET=http://localhost:8080

# Base path of the build, such as /slotbook/ for a GitHub Pages project site.
BASE_PATH=/
